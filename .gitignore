# Dependencies installed by Composer.
/core/
/vendor/
/modules/contrib/
/themes/contrib/
/profiles/contrib/
/modules/composer/
/themes/composer/
/libraries/
/drush/Commands/contrib/
/composer.phar

# Drupal scaffold files regenerated by composer install.
/.csslintrc
/.eslintignore
/.eslintrc.json
/.ht.router.php
/.htaccess
/autoload.php
/autoload_runtime.php
/index.php
/update.php
/robots.txt
/INSTALL.txt
/README.md
/example.gitignore
/modules/README.txt
/profiles/README.txt
/themes/README.txt
/recipes/README.txt
/sites/README.txt
/sites/development.services.yml
/sites/example.settings.local.php
/sites/example.sites.php
/sites/default/default.services.yml
/sites/default/default.settings.php

# Local settings, credentials, uploaded files, caches and generated assets.
/sites/*/settings*.php
!/sites/default/settings.contaelite.php
/sites/*/services.local.yml
/sites/*/services.yml
/sites/*/files/
/sites/simpletest/
/private/
/.env
/.env.*
!/.env.example
!/.env.*.example
*.sql
*.sql.gz
*.sqlite
*.sqlite3

# Shared DDEV config is versioned; runtime state stays local.
/.ddev/*
!/.ddev/config.yaml
!/.ddev/commands/
!/.ddev/config.*.yaml
/.ddev/config.local.yaml

# Local tools and generated development artifacts.
/.idea/
/.vscode/
/.drush/
/.drupal-console/
/.drupal-console.yml
/drush/backups/
/drush/sites/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache
.phpunit.cache/
coverage/

# OS, temporary files and previews.
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*.bak
*.backup
*.orig
*.log
*.tmp
*.sass-cache
*.cache
*.coverage
*.scssc
/contaelite-preview.png
/default.php
/docker-compose.override.yml

