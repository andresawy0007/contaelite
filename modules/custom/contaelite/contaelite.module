<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Component\Utility\UrlHelper;

/** Implements hook_preprocess_node(). */
function contaelite_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if ($node->bundle() !== 'landing_page') {
    return;
  }
  $path = \Drupal::service('extension.list.module')->getPath('contaelite');
  $definitions = json_decode(file_get_contents($path . '/data/landing.json'), TRUE);
  foreach ($definitions as $definition) {
    $value = $node->get($definition['name'])->value ?? '';
    if ($definition['kind'] === 'attribute') {
      $value = UrlHelper::stripDangerousProtocols($value);
    }
    $variables['ce'][$definition['name']] = $value;
  }
  for ($i = 1; $i <= 4; $i++) {
    $image = $node->get('field_ce_portrait_' . $i);
    if ($image->entity) {
      $variables['ce_portraits'][$i] = ['url' => \Drupal::service('file_url_generator')->generateString($image->entity->getFileUri()), 'alt' => $image->alt];
    }
  }
  $logo = $node->get('field_ce_logo')->entity;
  $variables['ce_logo'] = $logo ? \Drupal::service('file_url_generator')->generateString($logo->getFileUri()) : '/' . $path . '/assets/logo-header.webp';
  $variables['#attached']['drupalSettings']['contaelite'] = [
    'whatsapp' => preg_replace('/\D/', '', $node->get('field_ce_whatsapp')->value ?? ''),
    'phone' => preg_replace('/[^+0-9() -]/', '', $node->get('field_ce_phone')->value ?? ''),
    'email' => filter_var($node->get('field_ce_email')->value ?? '', FILTER_VALIDATE_EMAIL) ?: '',
    'privacy' => $node->get('field_ce_privacy')->value ?? '',
  ];
}

/** Implements hook_page_attachments(). */
function contaelite_page_attachments(array &$attachments): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'landing_page') {
    $attachments['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => ['name' => 'description', 'content' => $node->get('field_ce_description')->value ?? '']], 'contaelite_description'];
    $attachments['#cache']['tags'] = array_merge($attachments['#cache']['tags'] ?? [], $node->getCacheTags());
  }
}

/** Group the editorial fields by section. */
function contaelite_form_node_landing_page_form_alter(array &$form, FormStateInterface $form_state): void {
  $path = \Drupal::service('extension.list.module')->getPath('contaelite');
  $definitions = json_decode(file_get_contents($path . '/data/landing.json'), TRUE);
  $groups = [];
  foreach ($definitions as $definition) {
    $section = $definition['section'];
    if (!isset($groups[$section])) {
      $key = 'ce_section_' . count($groups);
      $groups[$section] = $key;
      $form[$key] = ['#type' => 'details', '#title' => $section, '#open' => FALSE, '#weight' => count($groups)];
    }
    $name = $definition['name'];
    if (isset($form[$name])) {
      $form[$name]['#group'] = $groups[$section];
      $form[$name]['#process'][] = [\Drupal\Core\Render\Element\RenderElementBase::class, 'processGroup'];
      $form[$name]['#pre_render'][] = [\Drupal\Core\Render\Element\RenderElementBase::class, 'preRenderGroup'];
    }
  }
}

/** Implements hook_form_FORM_ID_alter() for the edit form. */
function contaelite_form_node_landing_page_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  contaelite_form_node_landing_page_form_alter($form, $form_state);
}
